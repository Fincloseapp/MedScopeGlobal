{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers Builds / Create and deploy:
  //   Project name: medscopeglobal
  //   Production branch: main
  //   Root directory: /
  //   Build command: npm run cf:build
  //   Deploy command: npx opennextjs-cloudflare deploy
  //   (or Deploy only: npm run deploy)
  "name": "medscopeglobal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "medscopeglobal"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "MEDSCOPE_RUNTIME": "cloudflare-workers",
    "NEXT_PUBLIC_SITE_URL": "https://medscopeglobal.com",
    "NEXT_PUBLIC_ADS_ENABLED": "true",
    "NEXT_PUBLIC_ADSENSE_CLIENT_ID": "ca-pub-6820104998820692",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-6DX8RC4VZ1",
    "SENDGRID_FROM_EMAIL": "info@medscopeglobal.com",
    "SMTP_FROM_EMAIL": "info@medscopeglobal.com",
    "CF_EMAIL_SENDING": "1"
  },
  "routes": [
    { "pattern": "medscopeglobal.com/*", "zone_name": "medscopeglobal.com" },
    { "pattern": "www.medscopeglobal.com/*", "zone_name": "medscopeglobal.com" }
  ]
}