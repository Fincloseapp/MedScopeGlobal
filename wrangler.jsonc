{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers Builds — no API token in GitHub.
  // Dashboard → Worker medscopeglobal → Settings → Builds → Connect GitHub
  //   Production branch: main
  //   Root directory: /
  //   Build command: npm run cf:build
  //   Deploy command: npm run cf:workers-ci
  // Platform injects WORKERS_CI=1 and deploys with its own credentials.
  "build": {
    "command": "node scripts/cloudflare/ensure-opennext.mjs"
  },
  "name": "medscopeglobal",
  "main": "cloudflare/entry.js",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "medscopeglobal"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "MEDSCOPE_RUNTIME": "cloudflare-workers",
    "NEXT_PUBLIC_SITE_URL": "https://medscopeglobal.com",
    "NEXT_PUBLIC_ADS_ENABLED": "true",
    "NEXT_PUBLIC_ADSENSE_CLIENT_ID": "ca-pub-6820104998820692",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-6DX8RC4VZ1",
    "SENDGRID_FROM_EMAIL": "info@medscopeglobal.com",
    "SMTP_FROM_EMAIL": "info@medscopeglobal.com",
    "CF_EMAIL_SENDING": "1"
  },
  "routes": [
    { "pattern": "medscopeglobal.com/*", "zone_name": "medscopeglobal.com" },
    { "pattern": "www.medscopeglobal.com/*", "zone_name": "medscopeglobal.com" }
  ]
}