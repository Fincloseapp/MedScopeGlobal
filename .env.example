# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — auto DDL (npm run db:apply-pg or db:setup)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres
# SUPABASE_ACCESS_TOKEN=from https://supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF=your-project-ref

# Site URL (production canonical + OG)
NEXT_PUBLIC_SITE_URL=https://medscopeglobal.com

# Default language for ingested articles (cs | en)
INGESTION_LOCALE=cs
DEFAULT_SITE_LOCALE=cs

# Stripe — merchant account acct_1TO0PrDCziy2VdwH (Dashboard → Account details)
# Live keys must be from THAT account only; put them in .env.local / Worker secrets — never commit.
STRIPE_ACCOUNT_ID=acct_1TO0PrDCziy2VdwH
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Admin notifications (ad campaigns)
ADMIN_NOTIFY_EMAIL=dawe.zegzul@seznam.cz

# Legal operator identity (GDPR controller + imprint). Defaults match ARES IČO 06024963.
LEGAL_ENTITY_NAME=Al Synaptica Research Institute s.r.o.
LEGAL_ENTITY_TRADE_NAME=MedScopeGlobal
LEGAL_ENTITY_ICO=06024963
LEGAL_ENTITY_DIC=
LEGAL_ENTITY_ADDRESS=Třešňová 1046, Poruba, 73514 Orlová, Česká republika
LEGAL_ENTITY_COURT_FILE=C 70336/KSOS
LEGAL_ENTITY_DATA_BOX=
LEGAL_CONTACT_EMAIL=info@medscopeglobal.com
SUPPORT_EMAIL=info@medscopeglobal.com
SUPPORT_PHONE=+420 736 532 952

# Admin gate (/admin/login) — required to open /admin. Defaults to David if unset.
ADMIN_GATE_PASSWORD=David

# V5 — Groq (FREE, primary when set) — gsk_… from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant
GROQ_MODEL_FALLBACK_2=openai/gpt-oss-20b

# AI article ingestion (OpenAI — optional fallback #4)
# Must start with sk- (from https://platform.openai.com/api-keys). Do NOT paste Google/Gemini keys here.
OPENAI_API_KEY=

# Google AI Studio / Gemini (optional fallback #3) — AIza… or AQ.… from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# PubMed E-utilities (reduces 429 rate limits)
NCBI_CONTACT_EMAIL=info@medscopeglobal.com
NCBI_TOOL=medscopeglobal
# NCBI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cron: GET /api/cron/ingest?secret=... or Authorization: Bearer ...
CRON_SECRET=generate-a-long-random-string

# Academy AI video — HeyGen (preferred) or Synthesia
# HEYGEN_API_KEY=from https://app.heygen.com/settings?nav=API
# HEYGEN_AVATAR_ID=
# HEYGEN_VOICE_ID=
# SYNTHESIA_API_KEY=from https://app.synthesia.io/#/account/api
# SYNTHESIA_AVATAR_ID=
# VIDEO_WEBHOOK_SECRET=shared secret for /api/academy/video/webhook

# Academy expert review cron (weekly) — auto-publish approved drafts
# ACADEMY_EXPERT_REVIEW_AUTO_PUBLISH=true

# SendGrid — optional fallback. Production uses Cloudflare Email Sending
# from info@medscopeglobal.com (Worker binding EMAIL).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@medscopeglobal.com
# Optional: SendGrid Marketing list ID for bulk digest
SENDGRID_ACADEMY_LIST_ID=
# Fallback single recipient when no list ID
ACADEMY_NEWSLETTER_TO=
# Optional: SendGrid Event Webhook auth
SENDGRID_WEBHOOK_SECRET=

# SMTP fallback (v28 engine — used when SendGrid fails)
# Cloudflare Email Sending (recommended for medscopeglobal.com):
#   1) Dashboard → Email Service → Email Sending → Onboard Domain
#   2) Create API token with "Email Sending: Edit"
#   3) Username is literally: api_token   Password = that API token
#   4) Port 465 + implicit TLS only (587/STARTTLS not supported)
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USER=api_token
SMTP_PASS=
SMTP_FROM_EMAIL=info@medscopeglobal.com
SMTP_SECURE=true
# Apex sending is onboarded for info@medscopeglobal.com.
# Worker uses the EMAIL binding (Cloudflare Email Sending), not SMTP, in production.

# AI newsletter segments (optional list IDs or single TO)
NEWSLETTER_PUBLIC_LIST=
NEWSLETTER_PUBLIC_TO=
NEWSLETTER_STUDENTS_LIST=
NEWSLETTER_STUDENTS_TO=
NEWSLETTER_DOCTORS_LIST=
NEWSLETTER_DOCTORS_TO=

# Cloudflare Turnstile (anti-bot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (load only after cookie consent)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Display ads — owner pub is baked in (ca-pub-6820104998820692). Set false to disable.
# NEXT_PUBLIC_ADS_ENABLED=true
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-6820104998820692
# NEXT_PUBLIC_MEDIAVINE_SITE_ID=
# NEXT_PUBLIC_EZOIC_SITE_ID=
# NEXT_PUBLIC_ADS_SHOW_PLACEHOLDERS=1

# Amazon Associates — Tracking ID from Associates Central (never invent; never commit live tags)
# AFFILIATE_AMAZON_TAG=yourtag-20
# AFFILIATE_AMAZON_TAG_US=
# AFFILIATE_AMAZON_TAG_UK=
# AFFILIATE_AMAZON_TAG_DE=
# AFFILIATE_AMAZON_TAG_FR=
# AFFILIATE_AMAZON_TAG_IT=
# AFFILIATE_AMAZON_TAG_ES=
# AFFILIATE_AMAZON_TAG_PL=
# AFFILIATE_AMAZON_TAG_JP=
#
# Heureka Affiliate — official Trixam position id (from webmaster "Textový odkaz")
# AFFILIATE_HEUREKA_CZ_POSITION_ID=12345
# AFFILIATE_HEUREKA_SK_POSITION_ID=
# Or paste the generated HTML; we also accept it in /admin/vydelky (stored in DB).

# Security — AI keys server-side only (never NEXT_PUBLIC_)
# OPENAI_API_KEY is already above

# Production is Cloudflare Workers only (wrangler.jsonc, pnpm cf:deploy).

# Optional: fixed author UUID for ingested articles (defaults to first admin)
# INGESTION_AUTHOR_ID=
